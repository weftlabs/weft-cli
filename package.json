{
  "name": "@weftlabs/cli",
  "version": "0.31.0",
  "description": "Command-line client for the Weft buyer runtime",
  "type": "module",
  "bin": {
    "weft": "./bin/weft.mjs"
  },
  "files": [
    "bin",
    "dist",
    "examples",
    "README.md",
    "docs/contract.md",
    "scripts/install-skill.mjs",
    "scripts/skill-paths.mjs"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests && node --test scripts/publish-npm-archive.test.mjs scripts/sdk-follow.test.mjs scripts/skill-drift.test.mjs",
    "test:unit": "vitest run tests && node --test scripts/publish-npm-archive.test.mjs scripts/sdk-follow.test.mjs scripts/skill-drift.test.mjs",
    "test:packed": "node scripts/test-packed-artifact.mjs",
    "lint:check": "eslint",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\"",
    "prepack": "node scripts/prepare-skill.mjs",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "weft",
    "cli",
    "agents",
    "x402"
  ],
  "author": "Weft Labs",
  "license": "Apache-2.0",
  "homepage": "https://weftlabs.com/x402/cli",
  "repository": {
    "type": "git",
    "url": "https://github.com/weftlabs/weft-cli"
  },
  "bugs": {
    "url": "https://github.com/weftlabs/weft-cli/issues"
  },
  "dependencies": {
    "@weftlabs/sdk": "^0.31.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^10.11.0",
    "prettier": "3.9.9",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@10.33.4"
}
